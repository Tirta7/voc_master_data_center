<resources>
    <!-- Tema Utama: Fullscreen Kiosk NoActionBar -->
    <style name="Theme.VocFullDisplay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">#4F46E5</item> <!-- Indigo-600 -->
        <item name="colorPrimaryVariant">#3730A3</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary brand colors -->
        <item name="colorSecondary">#10B981</item> <!-- Emerald-500 -->
        <item name="colorSecondaryVariant">#047857</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <!-- Status Bar & Window Options -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">#0F172A</item> <!-- Slate-900 Premium Background -->
        <!-- Krusial: Konten masuk ke area notch/cutout agar tidak ada celah hitam -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Transparan status bar agar WebView benar-benar fullscreen -->
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
    </style>

    <!-- Tema Dialog untuk Pengaturan IP -->
    <style name="Theme.VocFullDisplay.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">#4F46E5</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
