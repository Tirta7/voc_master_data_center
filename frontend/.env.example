# ─────────────────────────────────────────────────────────────
# VOC BILLIARD SYSTEM — Frontend Environment Template
# Salin file ini menjadi .env.local dan isi nilainya
# cp frontend/.env.example frontend/.env.local
# ─────────────────────────────────────────────────────────────

# URL Backend API (update sesuai IP PC server)
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:4000

# MQTT WebSocket (untuk real-time di browser)
NEXT_PUBLIC_MQTT_URL=ws://YOUR_SERVER_IP:8083
