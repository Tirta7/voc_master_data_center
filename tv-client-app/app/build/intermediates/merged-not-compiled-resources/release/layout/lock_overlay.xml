<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FA0B0F19"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <!-- MAIN ALERT CARD -->
    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="40dp"
        android:gravity="center"
        android:layout_centerInParent="true">

        <!-- Glowing Lock Icon Container -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/card_background"
            android:backgroundTint="#2D1B2E"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="56sp"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WAKTU BILLING HABIS"
            android:textColor="#EF4444"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stasiun PlayStation Terkunci"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="160dp"
            android:layout_height="2dp"
            android:background="#EF4444"
            android:layout_marginBottom="20dp" />

        <!-- Subtitle Instruction -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Silakan hubungi kasir di depan untuk menambah waktu atau melakukan pembayaran sesi."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

    <!-- DEVICE METADATA FOR QUICK TROUBLESHOOTING (BOTTOM LEFT) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_margin="24dp"
        android:alpha="0.6">

        <TextView
            android:id="@+id/tvLockIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP Address: 192.168.1.XX"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:fontFamily="sans-serif-monospace" />

        <TextView
            android:id="@+id/tvLockWifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected to: SSID"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:fontFamily="sans-serif-monospace" />
    </LinearLayout>
</RelativeLayout>
