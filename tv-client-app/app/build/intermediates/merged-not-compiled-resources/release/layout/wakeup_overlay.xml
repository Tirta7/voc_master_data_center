<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Glowing Top Banner -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/card_background"
        android:backgroundTint="#0F172A"
        android:paddingLeft="28dp"
        android:paddingTop="16dp"
        android:paddingRight="28dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp">

        <!-- Info Badge -->
        <TextView
            android:id="@+id/tvWakeupBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SESSION ACTIVE"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/card_background"
            android:backgroundTint="#6366F1"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:layout_marginRight="16dp" />

        <!-- User / Title -->
        <TextView
            android:id="@+id/tvWakeupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Andre"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Divider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  |  "
            android:textColor="#334155"
            android:textSize="20sp" />

        <!-- Duration Info -->
        <TextView
            android:id="@+id/tvWakeupDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waktu 1jam : 30menit"
            android:textColor="#38BDF8"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>
</RelativeLayout>
