<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_background"
    android:backgroundTint="#FF0F172A"
    android:paddingLeft="20dp"
    android:paddingTop="12dp"
    android:paddingRight="24dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical"
    android:elevation="12dp"
    android:layout_margin="16dp">

    <!-- Left Badge/Indicator -->
    <TextView
        android:id="@+id/tvWakeupBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TIME ADDED"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/card_background"
        android:backgroundTint="#F59E0B"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp"
        android:layout_marginRight="14dp" />

    <!-- Content details -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWakeupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambahan waktu"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWakeupDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waktu 2jam : 00menit"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
