# ─────────────────────────────────────────────────────────────
# VOC BILLIARD SYSTEM — Environment Docker
# Multi-Location Ready Configuration Template
#
# Salin file ini: copy .env.example .env
# Lalu edit sesuai kebutuhan Anda
#
# PENTING: Setiap CLIENT/LOKASI harus punya .env berbeda!
# ─────────────────────────────────────────────────────────────

# ══ WAJIB DIISI - KONFIGURASI LOKASI ════════════════════════════

# ID unik lokasi ini (contoh: PIK_01, BDG_02, JKT_03)
LOCATION_ID=LOKASI_DEFAULT

# Nama lokasi untuk display di sistem
LOCATION_NAME=Lokasi Default

# IP address PC Server ini (cek dengan: ipconfig)
# JANGAN pakai 'localhost' — HP/client lain tidak bisa akses
SERVER_IP=192.168.1.100

# ══ Database ══════════════════════════════════════════════════════
DB_USERNAME=postgres
DB_DATABASE=billiard_db
DB_PORT=5432

# Password database (WAJIB ganti dengan password kuat!)
DB_PASSWORD=VocBilliard2024_Secure!

# ══ Redis ════════════════════════════════════════════════════════
REDIS_PORT=6379

# ══ MQTT - UNIK untuk setiap lokasi! ═════════════════════════════
# Ganti nama client agar tidak bentrok dengan client lain
MQTT_CLIENT_ID=billiard_server_lokasi_default

# ══ GOOGLE APPS SCRIPT - BERBEDA untuk setiap lokasi! ═══════════
# Setup GAS baru untuk setiap lokasi, lihat panduan GAS
GAS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GAS_SECRET=ganti_dengan_secret_rahasia_unik_anda

# ══ WhatsApp / Fonnte (opsional) ════════════════════════════
# Daftar di https://fonnte.com untuk fitur notifikasi WA
FONNTE_TOKEN=

# ══ PORT OVERRIDES (ubah jika port bentrok) ════════════════════
FRONTEND_PORT=3001
MQTT_PORT=1883
MQTT_WS_PORT=8083
