# ─────────────────────────────────────────────────────────────
# VOC BILLIARD SYSTEM — Environment Docker
# Salin file ini: copy .env.example .env
# Lalu edit SERVER_IP dan DB_PASSWORD sesuai kondisi Anda
# ─────────────────────────────────────────────────────────────

# ══ WAJIB diisi ══════════════════════════════════════════════

# IP address PC Server ini (cek dengan: ipconfig)
# JANGAN pakai 'localhost' — HP/client lain tidak bisa akses
SERVER_IP=192.168.1.100

# Password database (bebas, asal tidak kosong)
DB_PASSWORD=VocBilliard2024!

# ══ Database ══════════════════════════════════════════════════
DB_USERNAME=postgres
DB_DATABASE=billiard_db
DB_PORT=5432

# ══ Redis ══════════════════════════════════════════════════════
REDIS_PORT=6379

# ══ WhatsApp / Fonnte (opsional) ════════════════════════════
# Daftar di https://fonnte.com untuk fitur notifikasi WA
FONNTE_TOKEN=
