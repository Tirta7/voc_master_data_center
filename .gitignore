# ─────────────────────────────────────────────────────────────
# VOC BILLIARD SYSTEM — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Environments & Secrets (JANGAN pernah commit file ini!) ──────
.env
.env.local
.env.production
.env.development
.env.*.local
.env.example          # Template, bukan file dengan data real
backend/.env
frontend/.env.local
frontend/.env.production

# ── Token Files (berisi credential, JANGAN commit!) ──────────────
.token
DISTRIBUSI/.token
DISTRIBUSI/.env
*.token

# ── Docker Data (local only, jangan di-commit) ───────────────
mosquitto/config/pwfile       # MQTT password file
mosquitto/data/               # MQTT persistence data
mosquitto/logs/               # MQTT log files
postgres_data/               # PostgreSQL data volume
redis_data/                  # Redis data volume

# ── WhatsApp Session Keys (sensitif!) ────────────────────────
backend/auth_info_baileys/

# ── Node dependencies ─────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Build output ──────────────────────────────────────────────
backend/dist/
frontend/.next/
frontend/out/
DISTRIBUSI/frontend/.next/
**/.next/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pids/
*.pid

# ── Database & Cache ──────────────────────────────────────────
*.sql.bak
dump.rdb

# ── OS Files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────
.vscode/settings.json
.idea/

# ── File debug/temporary sesi ini ────────────────────────────
check*.txt
check*.js
check*.js
debug_*.py
debug_*.js
parse*.js
patch_*.py
final_*.py
find_*.py
normalize_*.py
reconstruct_*.py
repair_*.py
tmp_*.js
tmp_*.sql
tmp/
qc
query
Run
full_trace.txt
final_trace.txt

# ── PM2 ───────────────────────────────────────────────────────
.pm2/

# ── Android Build Artifacts (tv-client-app & vfd-app) ─────────
tv-client-app/app/build/
tv-client-app/build/
tv-client-app/.gradle/
vfd-app/app/build/
vfd-app/build/
vfd-app/.gradle/

# ── DISTRIBUSI: Jangan commit source code frontend ────────────
DISTRIBUSI/frontend/src/
DISTRIBUSI/backend/src/
DISTRIBUSI/frontend/Dockerfile
DISTRIBUSI/frontend/.dockerignore