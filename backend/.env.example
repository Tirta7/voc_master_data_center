# ─────────────────────────────────────────────────────────────
# VOC BILLIARD SYSTEM — Backend Environment Template
# Salin file ini menjadi .env dan isi nilainya
# cp backend/.env.example backend/.env
# ─────────────────────────────────────────────────────────────

# Database PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=4538
DB_USERNAME=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_DATABASE=billiard_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT Broker
MQTT_URL=mqtt://localhost:1883
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=billiard_server

# Server
PORT=4000
APP_URL=http://YOUR_SERVER_IP:4000

# WhatsApp (Fonnte) — https://fonnte.com
FONNTE_TOKEN=YOUR_FONNTE_TOKEN_HERE
