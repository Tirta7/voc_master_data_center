<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; -webkit-print-color-adjust: exact; font-size: 10px; letter-spacing: -0.01em; color: #0f172a; }
        .hero-gradient { background: linear-gradient(155deg, #020617 0%, #0f172a 40%, #1e1b4b 100%); margin-top: -25mm; padding-top: 25mm; }
        .card-flat { border: 1px solid #f1f5f9; background: #ffffff; }
        .hairline-grid > div { border-color: #f1f5f9; }
        @page { size: A4; margin: 25mm 15mm 20mm 15mm; }
        .no-break { page-break-inside: avoid; }
        .label-micro { font-size: 7px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: #94a3b8; }
        .value-condensed { font-size: 16px; font-weight: 900; letter-spacing: -0.04em; color: #0f172a; line-height: 1; }
        .value-sub { font-size: 8px; font-weight: 700; color: #64748b; }
        .section-header { border-left: 3px solid #6366f1; padding-left: 10px; margin-bottom: 12px; }
        .section-title-text { font-size: 9px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.15em; color: #1e293b; }
        tr { page-break-inside: avoid; }
        thead { display: table-header-group; }
    </style>
</head>
<body class="bg-[#fcfcfd] text-slate-900 antialiased p-0 m-0">
    
    <!-- HEADER -->
    <header class="hero-gradient px-6 pt-10 pb-8 text-white flex justify-between items-end relative overflow-hidden">
        <div class="z-10">
            <div class="inline-flex items-center gap-2 mb-2">
                <span class="w-6 h-0.5 bg-indigo-500 rounded-full"></span>
                <p class="text-[6.5px] font-black tracking-[0.4em] text-indigo-400 uppercase">Intelligence Matrix</p>
            </div>
            <h1 class="text-2xl font-black tracking-tighter mb-0.5">OPERATIONAL VISION</h1>
            <p class="text-slate-400 text-[9px] font-bold opacity-70">{{rangeLabel}} · {{reportId}}</p>
        </div>
        <div class="text-right z-10 flex gap-4">
            <div class="border-l border-white/10 pl-4 py-1">
                <p class="text-[6.5px] font-black text-slate-500 mb-0.5 uppercase tracking-widest">Gross sales</p>
                <p class="text-lg font-black text-white leading-none">{{fmt grossTotal}}</p>
            </div>
            <div class="border-l-2 border-emerald-500/50 pl-4 py-1">
                <p class="text-[6.5px] font-black text-emerald-400 mb-0.5 uppercase tracking-widest">Net liquidity</p>
                <p class="text-lg font-black text-emerald-400 leading-none">{{fmt netProfit}}</p>
            </div>
        </div>
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-indigo-500/10 blur-[100px] rounded-full"></div>
    </header>

    <main class="px-6 py-8 space-y-8">
        
        <!-- SECTION: ANALYTICAL CORE -->
        <section class="no-break">
            <div class="section-header">
                <h2 class="section-title-text">Intelligence Overview</h2>
            </div>
            
            <div class="grid grid-cols-2 lg:grid-cols-3 border border-slate-100 rounded-lg overflow-hidden bg-white hairline-grid">
                <div class="p-4 border-r border-b lg:border-b-0">
                    <p class="label-micro">Invoiced Total</p>
                    <p class="value-condensed mt-1 text-slate-900">{{fmt grossTotal}}</p>
                    <p class="value-sub mt-1">{{transactionCount}} Txns</p>
                </div>
                <div class="p-4 border-r border-b lg:border-b-0">
                    <p class="label-micro">Cash Settled</p>
                    <p class="value-condensed mt-1 text-emerald-600">{{fmt totalOmzet}}</p>
                    <p class="value-sub mt-1">Real Liquidity</p>
                </div>
                <div class="p-4 border-r border-b lg:border-b-0">
                    <p class="label-micro">Receivables</p>
                    <p class="value-condensed mt-1 text-rose-600">{{fmt unpaidAmount}}</p>
                    <p class="value-sub mt-1">Pending Sync</p>
                </div>
                <div class="p-4 border-r">
                    <p class="label-micro">ARPT</p>
                    <p class="value-condensed mt-1 text-slate-900">{{fmt avgTransactionValue}}</p>
                    <p class="value-sub mt-1">Avg Ticket Size</p>
                </div>
                <div class="p-4 border-r border-slate-100">
                    <p class="label-micro">Table Load</p>
                    <p class="value-condensed mt-1 text-slate-900">{{avgOccupancyMinutes}}<span class="text-[8px] opacity-40 ml-1">min</span></p>
                    <p class="value-sub mt-1">Cycle Duration</p>
                </div>
                <div class="p-4">
                    <p class="label-micro">Restock</p>
                    <p class="value-condensed mt-1 text-amber-500">{{inventoryCount}}</p>
                    <p class="value-sub mt-1">At-Risk Assets</p>
                </div>
            </div>

            <div class="grid grid-cols-12 gap-6 mt-8">
                <!-- LEADERBOARD: REVENUE SOURCES -->
                <div class="col-span-4 border border-slate-100 rounded-lg p-5 bg-white">
                    <h3 class="label-micro mb-4">Revenue Stream Analysis</h3>
                    <div class="space-y-3.5">
                        {{#each revenueStreams}}
                        <div>
                            <div class="flex justify-between items-end mb-1">
                                <span class="text-[8px] font-black text-slate-600 uppercase">{{label}}</span>
                                <span class="text-[9px] font-black text-slate-900">{{value}}</span>
                            </div>
                            <div class="h-1 w-full bg-slate-50 rounded-full overflow-hidden">
                                <div class="h-full bg-slate-800 rounded-full" style="width: {{percentage}}"></div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>

                <!-- LEADERBOARD: STAFF PERFORMANCE -->
                <div class="col-span-4 border border-slate-100 rounded-lg p-5 bg-white">
                    <h3 class="label-micro mb-4">Staff Revenue Attribution</h3>
                    <div class="space-y-3">
                        {{#each staffPerformance}}
                        <div class="flex justify-between items-center py-1.5 border-b border-slate-50 last:border-0">
                            <div class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-indigo-200"></span>
                                <span class="text-[9px] font-bold text-slate-700">{{name}}</span>
                            </div>
                            <div class="text-right">
                                <p class="text-[9px] font-black text-slate-900">{{revenue}}</p>
                                <p class="text-[7px] font-bold text-slate-400">{{percentage}} share</p>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>

                <!-- SETTLEMENT MATRIX -->
                <div class="col-span-4 border border-slate-100 rounded-lg p-5 bg-white">
                    <h3 class="label-micro mb-4">Settlement Distribution</h3>
                    <div class="grid grid-cols-2 gap-2">
                        {{#each paymentMethods}}
                        <div class="p-2 border border-slate-50 rounded bg-slate-50/30">
                            <p class="text-[6.5px] font-black text-slate-400 uppercase tracking-tight">{{method}}</p>
                            <div class="flex justify-between items-end">
                                <p class="text-[9px] font-bold text-slate-800">{{amount}}</p>
                                <p class="text-[7px] font-bold text-slate-400 opacity-60">{{count}}</p>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                    <div class="mt-4 pt-4 border-t border-slate-100 flex justify-between items-center">
                        <span class="label-micro">Loyalty Usage</span>
                        <span class="text-[10px] font-black text-indigo-600">{{fmt totalMemberUsage}}</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION: YIELD & VELOCITY -->
        <div class="grid grid-cols-12 gap-6 mt-8">
            <!-- YIELD ANALYSIS -->
            <div class="col-span-5 bg-white border border-slate-100 rounded-lg p-5">
                <h3 class="label-micro mb-4">Yield Optimization</h3>
                <div class="space-y-3">
                    <div class="flex justify-between items-center py-1">
                        <span class="text-[8.5px] font-bold text-slate-500">Service & Tax</span>
                        <span class="text-[9px] font-black text-slate-900">+ {{fmt totalTaxService}}</span>
                    </div>
                    <div class="flex justify-between items-center py-1">
                        <span class="text-[8.5px] font-bold text-slate-500">Marketing Cost</span>
                        <span class="text-[9px] font-black text-rose-500">- {{fmt totalDiscount}}</span>
                    </div>
                    <div class="flex justify-between items-center py-1">
                        <span class="text-[8.5px] font-bold text-slate-500">Operation Expenses</span>
                        <span class="text-[9px] font-black text-rose-500">- {{fmt totalExpenses}}</span>
                    </div>
                    <div class="flex justify-between items-center py-1">
                        <span class="text-[8.5px] font-bold text-slate-500">Accrued Commissions</span>
                        <span class="text-[9px] font-black text-rose-500">- {{fmt totalCommissions}}</span>
                    </div>
                    <div class="flex justify-between items-center py-1 border-b border-slate-50">
                        <span class="text-[8.5px] font-bold text-slate-500">Accrued Penalties</span>
                        <span class="text-[9px] font-black text-emerald-600">+ {{fmt totalPenalties}}</span>
                    </div>
                    <div class="flex justify-between items-center pt-2">
                        <span class="text-[8.5px] font-black text-emerald-500 uppercase tracking-widest">Net liquidity</span>
                        <span class="text-[11px] font-black text-emerald-600">{{fmt netProfit}}</span>
                    </div>
                </div>
                <!-- LOYALTY SUB-CARD -->
                <div class="mt-6 p-3 bg-slate-50 border border-slate-100 rounded-lg flex justify-between items-center">
                    <div>
                        <p class="text-[6.5px] font-black text-slate-400 uppercase tracking-widest">Loyalty Yield</p>
                        <p class="text-[8.5px] font-bold text-slate-700">Points Awarded</p>
                    </div>
                    <p class="text-sm font-black text-indigo-600">{{totalAwardedPoints}} <span class="text-[8px] opacity-40">PTS</span></p>
                </div>
            </div>

            <!-- TABLE OCCUPANCY INTELLIGENCE -->
            <div class="col-span-7 bg-white border border-slate-100 rounded-lg p-5">
                <h3 class="label-micro mb-4">Facility Utilization Velocity</h3>
                <div class="grid grid-cols-4 gap-2">
                    {{#each tableOccupancy}}
                    <div class="p-2.5 border border-slate-100 rounded bg-white">
                        <p class="text-[7.5px] font-black text-slate-700 leading-tight">{{name}}</p>
                        <div class="flex items-end gap-1.5 mt-1.5">
                            <span class="text-[10px] font-black text-slate-900 leading-none">{{minutes}}</span>
                            <span class="text-[6.5px] font-bold text-slate-400 uppercase leading-none pb-0.5">Min</span>
                        </div>
                        <p class="text-[6.5px] font-bold text-indigo-400 mt-1 uppercase">{{sessions}} cycles</p>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>

        <!-- SECTION: TEMPORAL VELOCITY -->
        <div class="mt-8 no-break">
            <h3 class="label-micro mb-5">Hourly Revenue Velocity</h3>
            <div class="flex items-end h-16 gap-[1px]">
                {{#each hourlyData}}
                <div class="flex-grow flex flex-col items-center group h-full justify-end">
                    <div class="w-full {{#if isNight}}bg-indigo-500{{else}}bg-slate-200{{/if}} rounded-t-[1px]" style="height: {{width}}%;"></div>
                    <span class="text-[5px] font-bold text-slate-300 mt-1 opacity-0 group-hover:opacity-100 transition-opacity">{{hour}}h</span>
                </div>
                {{/each}}
            </div>
            <div class="flex justify-between mt-2 px-1">
                <span class="text-[6px] font-black text-slate-300 uppercase">00:00 Cycle Start</span>
                <span class="text-[6px] font-black text-slate-300 uppercase italic">Peak Load Analysis</span>
                <span class="text-[6px] font-black text-slate-300 uppercase text-right">23:59 Cycle End</span>
            </div>
        </div>

        <!-- SECTION: OPERATIONAL ASSETS -->
        <div class="grid grid-cols-12 gap-6 mt-8">
            <div class="col-span-8 border border-slate-100 rounded-lg overflow-hidden bg-white">
                <table class="w-full">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-100">
                            <th class="px-4 py-2.5 text-left label-micro">Asset</th>
                            <th class="px-4 py-2.5 text-center label-micro">Vol</th>
                            <th class="px-4 py-2.5 text-right label-micro">Revenue</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {{#each topItems}}
                        <tr>
                            <td class="px-4 py-2">
                                <p class="text-[8.5px] font-black text-slate-800 uppercase leading-tight">{{name}}</p>
                                <p class="text-[6.5px] font-bold text-slate-300 mt-1 uppercase">{{category}}</p>
                            </td>
                            <td class="px-4 py-2 text-center">
                                <span class="text-[8.5px] font-bold text-slate-500">{{qty}}</span>
                            </td>
                            <td class="px-4 py-2 text-right">
                                <span class="text-[8.5px] font-black text-slate-900">{{revenue}}</span>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <div class="col-span-4 space-y-4">
                <!-- INVENTORY ALERT -->
                <div class="border border-rose-100 bg-rose-50/30 rounded-lg p-4">
                    <h3 class="label-micro text-rose-400 mb-3">Asset Depletion Alerts</h3>
                    <div class="space-y-1.5">
                        {{#each criticalStock}}
                        <div class="flex justify-between items-center py-1 border-b border-rose-100/30 last:border-0">
                            <span class="text-[8px] font-bold text-slate-600 mr-2">{{name}}</span>
                            <span class="text-[8.5px] font-black text-rose-600">{{stock}}</span>
                        </div>
                        {{/each}}
                        {{#unless criticalStock}}
                        <p class="text-[7.5px] text-emerald-500 font-black italic">Inventory Stability Verified ✓</p>
                        {{/unless}}
                    </div>
                </div>

                <!-- ANALYTICS SIGNATURE -->
                <div class="border border-slate-100 rounded-lg p-4 bg-white flex items-center justify-center">
                    <div class="text-center">
                        <p class="text-[6px] font-black text-slate-300 uppercase tracking-widest mb-1">Authenticated By</p>
                        <p class="text-[8px] font-black text-slate-600 uppercase italic leading-none">Intelligence Engine v2.0</p>
                    </div>
                </div>
            </div>
        </div>

        <footer class="mt-8 pt-6 border-t border-slate-100 text-center">
            <p class="text-[7.5px] font-bold text-slate-300 uppercase tracking-[0.2em] opacity-80">
                A4 Intelligence-Grade Compact Report · Confidential
            </p>
        </footer>

    </main>

    <div class="px-14 py-10 flex justify-between items-center text-slate-400 border-t border-slate-100 bg-white">
        <p class="text-[8px] font-bold tracking-[0.3em] uppercase opacity-60">VOC / SYSTEMS ANALYTICS</p>
        <div class="flex items-center gap-6">
            <span class="text-[8px] font-bold uppercase tracking-widest">Verified Digital Output</span>
            <span class="text-[8px] font-bold uppercase tracking-widest">A4 Proportional</span>
        </div>
    </div>

</body>
</html>
