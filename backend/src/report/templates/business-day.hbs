<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; -webkit-print-color-adjust: exact; font-size: 10px; letter-spacing: -0.01em; color: #010409; }
        .hero-gradient { background: linear-gradient(155deg, #020617 0%, #0f172a 100%); margin-top: -25mm; padding-top: 25mm; }
        .card-flat { border: 1px solid #f1f5f9; background: #ffffff; }
        .hairline-grid > div { border-color: #f1f5f9; }
        @page { size: A4; margin: 25mm 15mm 20mm 15mm; }
        .no-break { page-break-inside: avoid; }
        .label-micro { font-size: 7px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: #94a3b8; }
        .value-condensed { font-size: 14px; font-weight: 900; letter-spacing: -0.04em; color: #0f172a; line-height: 1; }
        .section-header { border-left: 3px solid #6366f1; padding-left: 10px; margin-bottom: 12px; }
        .section-title-text { font-size: 9px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.15em; color: #1e293b; }
        tr { page-break-inside: avoid; }
        thead { display: table-header-group; }
    </style>
</head>
<body class="bg-[#fcfcfd] text-slate-900 antialiased p-0 m-0">
    
    <!-- HEADER -->
    <header class="hero-gradient px-6 pt-10 pb-8 text-white flex justify-between items-end relative overflow-hidden">
        <div class="z-10">
            <div class="inline-flex items-center gap-2 mb-2">
                <span class="w-6 h-0.5 bg-indigo-500 rounded-full"></span>
                <p class="text-[6.5px] font-black tracking-[0.4em] text-indigo-400 uppercase">Audit Intelligence</p>
            </div>
            <h1 class="text-2xl font-black tracking-tighter mb-0.5">OPERATIONAL SUMMARY</h1>
            <p class="text-slate-400 text-[9px] font-bold opacity-70">{{venueName}} · {{businessDate}}</p>
        </div>
        <div class="text-right z-10 flex gap-4">
            <div class="border-l border-white/10 pl-4 py-1 text-right">
                <p class="text-[6.5px] font-black text-slate-500 mb-0.5 uppercase tracking-widest">Processing cycle</p>
                <p class="text-lg font-black text-white leading-none">{{totalTransactions}} <span class="text-[9px] opacity-40">TXS</span></p>
            </div>
        </div>
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-indigo-500/10 blur-[100px] rounded-full"></div>
    </header>

    <main class="px-6 py-8 space-y-8">
        
        <!-- SECTION: AUDIT CORE -->
        <section class="no-break">
            <div class="section-header">
                <h2 class="section-title-text">Audit Pulse</h2>
            </div>
            
            <div class="grid grid-cols-2 lg:grid-cols-4 border border-slate-100 rounded-lg overflow-hidden bg-white hairline-grid">
                <div class="p-4 border-r border-b lg:border-b-0">
                    <p class="label-micro text-indigo-500">Omzet Cash</p>
                    <p class="value-condensed mt-1 text-indigo-600">{{fmt totalOmzet}}</p>
                    <p class="text-[7.5px] font-bold text-slate-400 mt-1 uppercase">Physical Pool</p>
                </div>
                <div class="p-4 border-r border-b lg:border-b-0">
                    <p class="label-micro text-slate-500">Gross Sales</p>
                    <p class="value-condensed mt-1 text-slate-900">{{fmt grossRevenue}}</p>
                    <p class="text-[7.5px] font-bold text-slate-400 mt-1 uppercase">Theoretical</p>
                </div>
                <div class="p-4 border-r">
                    <p class="label-micro text-slate-500">Cafe Contribution</p>
                    <p class="value-condensed mt-1 text-slate-900">{{fmt grossCafe}}</p>
                    <p class="text-[7.5px] font-bold text-slate-400 mt-1 uppercase">F&B Movement</p>
                </div>
                <div class="p-4">
                    <p class="label-micro text-slate-500">Audit Time</p>
                    <p class="text-[10px] font-black text-slate-800 mt-1">{{printTime}}</p>
                    <p class="text-[7.5px] font-bold text-slate-400 mt-1 uppercase">Verified Log</p>
                </div>
            </div>

            <div class="grid grid-cols-12 gap-8 mt-8 items-start">
                <!-- ACCOUNTING RECONCILIATION -->
                <div class="col-span-8 bg-white border border-slate-100 rounded-lg p-6">
                    <h3 class="label-micro mb-4">Accounting Reconciliation</h3>
                    <table class="w-full text-[9px] border-collapse">
                        <tbody class="divide-y divide-slate-50">
                            <tr>
                                <td class="py-2.5 font-bold text-slate-500">Gross Billiard Revenue</td>
                                <td class="py-2.5 text-right font-black text-slate-900">{{fmt grossBilliard}}</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 font-bold text-slate-500">Gross PlayStation Revenue</td>
                                <td class="py-2.5 text-right font-black text-slate-900">{{fmt grossPlaystation}}</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 font-bold text-slate-500">Gross Café / F&B Sales</td>
                                <td class="py-2.5 text-right font-black text-slate-900">{{fmt grossCafe}}</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 font-black text-rose-500 uppercase tracking-widest text-[8px]">Marketing Deductions</td>
                                <td class="py-2.5 text-right font-black text-rose-600">- {{fmt totalDiscount}}</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 font-bold text-slate-500">Tax & Service Adjustments</td>
                                <td class="py-2.5 text-right font-black text-slate-900">+ {{fmt totalTax}} / {{fmt totalService}}</td>
                            </tr>
                            <tr class="bg-slate-900 text-white !border-t-2 border-indigo-500">
                                <td class="py-4 px-6 font-black uppercase tracking-[0.2em] text-[8px]">Total Reconciled Intake</td>
                                <td class="py-4 px-6 text-right font-black text-lg text-emerald-400 leading-none">{{fmt totalOmzet}}</td>
                            </tr>
                            <tr class="bg-slate-50">
                                <td class="py-2.5 px-6 font-bold text-slate-500 italic">Total Operational Expenses</td>
                                <td class="py-2.5 px-6 text-right font-black text-rose-600">- {{fmt totalExpenses}}</td>
                            </tr>
                            <tr class="bg-indigo-900 text-white !border-t-2 border-indigo-400">
                                <td class="py-4 px-6 font-black uppercase tracking-[0.2em] text-[8px]">Net Profit (EBITDA)</td>
                                <td class="py-4 px-6 text-right font-black text-lg text-emerald-300 leading-none">{{fmt netProfit}}</td>
                            </tr>
                        </tbody>
                    </table>

                </div>

                <!-- YIELD ANALYSIS -->
                <div class="col-span-4 space-y-4">
                    <div class="bg-white border border-slate-100 rounded-lg p-5">
                        <h3 class="label-micro mb-4">Top Asset Movement</h3>
                        <div class="space-y-2">
                            {{#each sortedPackages}}
                            <div class="flex justify-between items-center py-1 border-b border-slate-50 last:border-0">
                                <span class="text-[8.5px] font-bold text-slate-700 mr-2">{{name}}</span>
                                <span class="px-1.5 py-0.5 bg-indigo-50 text-indigo-600 rounded font-black text-[7px]">{{count}}x</span>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    <div class="bg-white border border-slate-100 rounded-lg p-5">
                        <h3 class="label-micro mb-4">Top F&B Velocity</h3>
                        <div class="space-y-2">
                            {{#each sortedItems}}
                            <div class="flex justify-between items-center py-1 border-b border-slate-50 last:border-0">
                                <span class="text-[8.5px] font-bold text-slate-700 mr-2">{{name}}</span>
                                <span class="px-1.5 py-0.5 bg-amber-50 text-amber-600 rounded font-black text-[7px]">{{qty}}u</span>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION: SHIFT AUDIT -->
        <section class="no-break border-t border-slate-100 pt-8">
            <h2 class="label-micro mb-4">Shift Accountability</h2>
            <div class="grid grid-cols-3 gap-4">
                {{#each shifts}}
                <div class="bg-white border border-slate-100 rounded-lg p-3.5 flex justify-between items-center {{#unless endTime}}bg-emerald-50/10 border-emerald-100{{/unless}}">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <p class="text-[8.5px] font-black text-slate-800 uppercase tracking-tight">{{userName}}</p>
                            {{#unless endTime}}
                            <span class="text-[6px] font-black text-emerald-500 uppercase italic">Active</span>
                            {{/unless}}
                        </div>
                        <p class="text-[6.5px] text-slate-400 font-bold uppercase tracking-widest leading-none">{{startTime}} — {{#if endTime}}{{endTime}}{{else}}PRESENT{{/if}}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-[9px] font-black text-slate-900 mb-0.5">{{revenue}}</p>
                        <p class="text-[6.5px] font-black uppercase tracking-widest {{#if isDiscrepancy}}text-rose-500{{else}}text-emerald-500{{/if}}">
                            {{#if isDiscrepancy}}{{discrepancy}}{{else}}Balanced ✓{{/if}}
                        </p>
                    </div>
                </div>
                {{/each}}
            </div>
        </section>

        <!-- SECTION: LEDGER -->
        <section class="mt-8 no-break">
            <h2 class="label-micro mb-4">Detailed Audit Ledger</h2>
            <div class="bg-white border border-slate-100 rounded-lg overflow-hidden">
                 <table class="w-full text-left">
                    <thead class="bg-slate-50 border-b border-slate-100">
                        <tr class="label-micro">
                            <th class="py-2.5 px-6">Manifest / ID</th>
                            <th class="py-2.5 px-4 text-center">Entity</th>
                            <th class="py-2.5 px-4">Protocol Details</th>
                            <th class="py-2.5 px-6 text-right">Settlement</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {{#each transactions}}
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="py-2 px-6">
                                <span class="text-[8.5px] font-black text-slate-900 tracking-tighter">#{{invoiceNumber}}</span>
                                <p class="text-[6.5px] text-slate-300 font-bold mt-0.5 uppercase tracking-tighter">{{time}}</p>
                            </td>
                            <td class="py-2 px-4 text-center">
                                <span class="text-[7.5px] font-black text-slate-500 uppercase tracking-tight">{{tableNumber}}</span>
                            </td>
                            <td class="py-2 px-4">
                                <p class="text-[8px] text-slate-500 font-bold italic tracking-tight">{{items}}</p>
                                <p class="text-[6.5px] text-slate-300 mt-0.5 uppercase font-black tracking-tight">{{customerName}} · {{paymentMethod}}</p>
                            </td>
                            <td class="py-2 px-6 text-right">
                                <span class="text-[9px] font-black text-slate-900">{{amount}}</span>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </section>

        <footer class="mt-8 pt-6 border-t border-slate-100 flex justify-between items-center text-slate-300">
            <p class="text-[7px] font-black tracking-[0.2em] uppercase opacity-40">VOC BI PIPELINE · DATA SECURE</p>
            <p class="text-[7px] font-bold text-slate-400 uppercase text-right leading-none tracking-widest">
                VERIFIED DIGITAL SYSTEM · <span class="italic font-black text-indigo-400">ULTRA HIGH DENSITY</span>
            </p>
        </footer>
    </main>

</body>
</html>
