# ================================================================
#  VOC Billiard - Template Token (SALIN & ISI sebelum instalasi)
#
#  Cara penggunaan:
#  1. SALIN file ini → rename menjadi ".token" (tanpa .example)
#  2. Isi GITHUB_TOKEN dengan token dari teknisi VOC
#  3. Isi LOCATION_NAME sesuai nama lokasi client
#  4. Copy file .token bersama folder DISTRIBUSI ke PC client
#  5. Jalankan INSTALL.bat atau MULAI.ps1
#
#  PERINGATAN: File .token JANGAN di-share / upload ke internet!
# ================================================================

# Token GitHub untuk download image Docker (dari teknisi VOC)
GITHUB_TOKEN=MASUKKAN_TOKEN_DISINI

# Nama lokasi client
LOCATION_NAME=NAMA_LOKASI_CLIENT

# Token Fonnte untuk notifikasi WhatsApp (opsional, bisa kosong)
FONNTE_TOKEN=
