# ================================================================
#  VOC Billiard — File Token Instalasi Client
#
#  CARA PENGGUNAAN:
#  1. SALIN file ini → rename menjadi ".token" (hapus .example)
#  2. Isi GITHUB_TOKEN dengan Personal Access Token (classic)
#     dari akun GitHub: https://github.com/Tirta7
#     Scope yang dibutuhkan: read:packages
#  3. Isi LOCATION_NAME sesuai nama lokasi client
#  4. Copy seluruh folder INSTALLER_CLIENT ke PC client
#  5. Klik 2x INSTALL.bat → pilih Run as Administrator
#
#  PERINGATAN: File .token JANGAN di-share / upload ke internet!
#  File ini berisi token rahasia yang harus dijaga kerahasiaannya.
# ================================================================

# --- Token GitHub PAT (Personal Access Token Classic) ---
# Buat di: https://github.com/settings/tokens/new
# Centang scope: read:packages
GITHUB_TOKEN=MASUKKAN_TOKEN_DISINI

# --- Username GitHub (jangan diubah) ---
GITHUB_USERNAME=tirta7

# --- Nama Lokasi Client ---
LOCATION_NAME=NAMA_LOKASI_CLIENT

# --- Token Fonnte untuk notifikasi WhatsApp (opsional) ---
FONNTE_TOKEN=

# --- Zona Waktu: WIB / WITA / WIT ---
TIMEZONE_ZONE=WIB
